{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "donezo-reminders",
  "main": "src/index.ts",
  "workers_dev": false,
  "preview_urls": false,
  "compatibility_date": "2026-08-03",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "triggers": {
    "crons": ["* * * * *"]
  },
  "vars": {
    "WEB_PUSH_SUBJECT": "mailto:support@mv-builds.com"
  }
}
