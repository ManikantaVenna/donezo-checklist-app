{
  "expo": {
    "name": "Donezo",
    "slug": "donezo",
    "version": "1.0.0",
    "scheme": "donezo",
    "orientation": "portrait",
    "icon": "./assets/donezo-app-icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mvbuilds.donezo",
      "buildNumber": "1"
    },
    "android": {
      "package": "com.mvbuilds.donezo",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#07080B",
        "foregroundImage": "./assets/donezo-android-foreground.png",
        "backgroundImage": "./assets/donezo-android-background.png",
        "monochromeImage": "./assets/donezo-android-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/donezo-favicon.png",
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-font",
      [
        "expo-notifications",
        {
          "icon": "./assets/donezo-android-monochrome.png",
          "color": "#E7B94E"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/donezo-splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#07080B",
          "dark": {
            "image": "./assets/donezo-splash-icon.png",
            "backgroundColor": "#07080B"
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "9d95ca72-747f-47f2-942c-7054cfd2a6a3"
      }
    },
    "owner": "mv-builds"
  }
}
